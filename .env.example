# Both variables are optional: the defaults below are baked in and match the demo deployment.
# Set them in Cloudflare Pages (Settings → Environment variables) or in a local `.env.local`.

# Absolute URL of the database repo's published index (database.json).
NEXT_PUBLIC_DATABASE_INDEX_URL=https://programming-club-demo-data.pages.dev/database.json

# Public address of this website — used for canonical / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://pcstat.org
