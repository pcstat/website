# Optional — the site builds without a .env file.
#
# Where the database lives is NOT configured here: see database.json at the root of this repo.

# Public address of this website — used for canonical / Open Graph metadata.
# Default: https://pcstat.org
# In GitHub Actions, set it with a repository *variable* (not a secret) of the same name.
# NEXT_PUBLIC_SITE_URL=https://pcstat.org

# Address of the admin panel, for the admin's live preview. Normally set as "admin" in database.json;
# this variable overrides it (useful locally: NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3000).
# In GitHub Actions set a repository *variable* of the same name.
# NEXT_PUBLIC_ADMIN_ORIGIN=
